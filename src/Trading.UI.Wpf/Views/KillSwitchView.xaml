<UserControl x:Class="Trading.UI.Wpf.Views.KillSwitchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="KillSwitch.View"
             AutomationProperties.Name="Authorized hierarchical kill switches">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Kill switches" FontSize="22" FontWeight="Bold"
                   AutomationProperties.HeadingLevel="Level1" />
        <StackPanel DockPanel.Dock="Top" AutomationProperties.LiveSetting="Assertive">
            <TextBlock Text="{Binding EffectiveState}" FontWeight="Bold" Foreground="DarkRed"
                       AutomationProperties.AutomationId="KillSwitch.EffectiveState" />
            <TextBlock Text="{Binding Outcome}" AutomationProperties.AutomationId="KillSwitch.Outcome" />
            <TextBlock Text="{Binding PendingState}" AutomationProperties.AutomationId="KillSwitch.PendingState" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12">
            <Label Content="Reason" Target="{Binding ElementName=ReasonBox}" />
            <TextBox x:Name="ReasonBox" Text="{Binding Reason}" AutomationProperties.AutomationId="KillSwitch.Reason" />
            <TextBlock Text="Type the exact action and scope shown below to confirm." />
            <TextBlock Text="{Binding RequiredActivationConfirmation}" AutomationProperties.AutomationId="KillSwitch.ActivationPhrase" />
            <TextBlock Text="{Binding RequiredClearConfirmation}" AutomationProperties.AutomationId="KillSwitch.ClearPhrase" />
            <Label Content="Exact confirmation" Target="{Binding ElementName=ConfirmationBox}" />
            <TextBox x:Name="ConfirmationBox" Text="{Binding Confirmation}"
                     AutomationProperties.AutomationId="KillSwitch.Confirmation" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Activate selected kill switch" Command="{Binding ActivateCommand}"
                        AutomationProperties.AutomationId="KillSwitch.Activate"
                        AutomationProperties.Name="Activate selected kill switch after exact scope confirmation" />
                <Button Content="Clear selected kill switch" Command="{Binding ClearCommand}"
                        AutomationProperties.AutomationId="KillSwitch.Clear"
                        AutomationProperties.Name="Clear selected kill switch after exact scope confirmation" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="KillSwitch.Refresh" />
            </StackPanel>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <DataGrid Grid.Column="0" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.AutomationId="KillSwitch.Scopes"
                      AutomationProperties.Name="Authorized kill-switch scopes">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" />
                    <DataGridCheckBoxColumn Header="Directly active" Binding="{Binding IsActive}" />
                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" />
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Column="1">
                <Button Content="Open selected scope" Command="{Binding LoadCommand}"
                        AutomationProperties.AutomationId="KillSwitch.Open" />
                <ItemsControl ItemsSource="{Binding History}" AutomationProperties.AutomationId="KillSwitch.History"
                              AutomationProperties.Name="Immutable kill-switch history" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
